
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Python auf Fedora ausführen",
            "type": "shell",
            "command": "flatpak-spawn",
            "args": [
                "--host",
                "/usr/bin/python3",
                "${file}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
